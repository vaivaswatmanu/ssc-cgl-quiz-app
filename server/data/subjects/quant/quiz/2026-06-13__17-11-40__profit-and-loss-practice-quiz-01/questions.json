        {
          "questionId": "q1",
          "questionText": "An article is bought for ₹720 and sold for ₹900. Find the profit percentage.",
          "options": [
            {
              "id": "A",
              "text": "20%"
            },
            {
              "id": "B",
              "text": "22.5%"
            },
            {
              "id": "C",
              "text": "25%"
            },
            {
              "id": "D",
              "text": "30%"
            }
          ],
          "correctOptionId": "C",
          "solution": "Profit = 900−720 = 180. Profit% = 180/720 × 100 = 25%."
        },
        {
          "questionId": "q2",
          "questionText": "An article costing ₹1250 is sold at a loss of 16%. Find the selling price.",
